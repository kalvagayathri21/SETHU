NODE_ENV=development
API_PORT=3001
DATABASE_URL=postgresql://sethu_user:change-me@localhost:5432/sethu
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
APP_TIME_ZONE=Asia/Kolkata
UPLOAD_DIR=uploads
PRIVATE_UPLOAD_DIR=private-uploads
PGPOOL_MAX=10
PGSSL=false
TRUST_PROXY=false

# Required only when creating the initial administrator with npm run admin:create
ADMIN_NAME=SETHU Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=+910000000000
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
