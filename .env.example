NODE_ENV=development
PORT=
API_PORT=3001
DATABASE_URL=your_neon_postgresql_connection_string
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5175,http://127.0.0.1:5175
VITE_API_BASE=/api
APP_TIME_ZONE=Asia/Kolkata
UPLOAD_DIR=uploads
PRIVATE_UPLOAD_DIR=private-uploads
PGPOOL_MAX=10
PGSSL=false
TRUST_PROXY=false

# Required only when creating the initial administrator with npm run admin:create
ADMIN_NAME=SETHU Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=+910000000000
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
